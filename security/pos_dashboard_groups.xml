<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Catégorie du module -->
    <record id="module_category_pos_dashboard" model="ir.module.category">
        <field name="name">Dashboard Point de Vente</field>
        <field name="sequence">50</field>
    </record>

    <!-- Groupe Utilisateur -->
    <record id="group_pos_dashboard_user" model="res.groups">
        <field name="name">Utilisateur Dashboard PdV</field>
        <field name="category_id" ref="module_category_pos_dashboard"/>
    </record>

    <!-- Groupe Responsable (implique Utilisateur) -->
    <record id="group_pos_dashboard_manager" model="res.groups">
        <field name="name">Responsable Dashboard PdV</field>
        <field name="category_id" ref="module_category_pos_dashboard"/>
        <field name="implied_ids" eval="[(4, ref('group_pos_dashboard_user'))]"/>
    </record>

    <!-- Le groupe POS Manager implique automatiquement le groupe Responsable Dashboard -->
    <record id="point_of_sale.group_pos_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_pos_dashboard_manager'))]"/>
    </record>
</odoo>
