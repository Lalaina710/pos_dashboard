<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="pos_dashboard.PosDashboard">
        <div t-attf-class="pos_dashboard {{ state.darkMode ? 'dark-mode' : '' }}">
            <!-- Header avec contrôles -->
            <div class="db-header">
                <div class="d-flex justify-content-between align-items-center">
                    <h1 class="db-title mb-0">Tableau de bord Point de Vente</h1>
                    <div class="db-controls">
                        <span class="db-last-update" t-if="state.lastUpdate">
                            <i class="fa fa-clock-o"/> <t t-esc="state.lastUpdate"/>
                        </span>

                        <!-- Auto-refresh -->
                        <select class="db-select"
                                t-on-change="(ev) => this.onRefreshIntervalChange(ev)">
                            <option value="0" t-att-selected="state.autoRefreshInterval === 0 ? 'selected' : undefined">
                                Auto: Off
                            </option>
                            <option value="30" t-att-selected="state.autoRefreshInterval === 30 ? 'selected' : undefined">
                                30s
                            </option>
                            <option value="60" t-att-selected="state.autoRefreshInterval === 60 ? 'selected' : undefined">
                                1 min
                            </option>
                            <option value="120" t-att-selected="state.autoRefreshInterval === 120 ? 'selected' : undefined">
                                2 min
                            </option>
                            <option value="300" t-att-selected="state.autoRefreshInterval === 300 ? 'selected' : undefined">
                                5 min
                            </option>
                        </select>

                        <button t-attf-class="btn-filter {{ hasActiveFilters() ? 'active' : '' }}"
                                t-on-click="toggleFilters">
                            <i class="fa fa-filter"/>
                            Filtres
                            <span class="filter-dot" t-if="hasActiveFilters()"/>
                        </button>

                        <button class="btn-theme" t-on-click="toggleTheme">
                            <i t-attf-class="fa {{ state.darkMode ? 'fa-sun-o' : 'fa-moon-o' }}"/>
                        </button>

                        <button class="btn-refresh" t-on-click="() => this.loadData()">
                            <i class="fa fa-refresh"/> Actualiser
                        </button>
                    </div>
                </div>

                <!-- Panneau de filtres (collapsible) -->
                <div class="db-filters-panel" t-if="state.showFilters">
                    <div class="filters-grid">
                        <div class="filter-group">
                            <label>Date début</label>
                            <input type="date" class="filter-input"
                                   t-att-value="state.filters.date_from"
                                   t-on-change="(ev) => this.onFilterChange('date_from', ev)"/>
                        </div>
                        <div class="filter-group">
                            <label>Date fin</label>
                            <input type="date" class="filter-input"
                                   t-att-value="state.filters.date_to"
                                   t-on-change="(ev) => this.onFilterChange('date_to', ev)"/>
                        </div>
                        <div class="filter-group">
                            <label>Point de vente</label>
                            <select class="filter-input"
                                    t-on-change="(ev) => this.onFilterChange('pos_config_id', ev)">
                                <option value="0">-- Tous --</option>
                                <t t-foreach="state.pos_configs" t-as="cfg" t-key="cfg.id">
                                    <option t-att-value="cfg.id"
                                            t-att-selected="state.filters.pos_config_id === cfg.id ? 'selected' : undefined">
                                        <t t-esc="cfg.name"/>
                                    </option>
                                </t>
                            </select>
                        </div>
                        <div class="filter-group">
                            <label>Caissier</label>
                            <select class="filter-input"
                                    t-on-change="(ev) => this.onFilterChange('user_id', ev)">
                                <option value="0">-- Tous --</option>
                                <t t-foreach="state.users" t-as="user" t-key="user.id">
                                    <option t-att-value="user.id"
                                            t-att-selected="state.filters.user_id === user.id ? 'selected' : undefined">
                                        <t t-esc="user.name"/>
                                    </option>
                                </t>
                            </select>
                        </div>
                        <div class="filter-group">
                            <label>Jours graphique</label>
                            <select class="filter-input"
                                    t-on-change="(ev) => this.onFilterChange('chart_days', ev)">
                                <option value="7" t-att-selected="state.filters.chart_days === 7 ? 'selected' : undefined">7 jours</option>
                                <option value="14" t-att-selected="state.filters.chart_days === 14 ? 'selected' : undefined">14 jours</option>
                                <option value="30" t-att-selected="state.filters.chart_days === 30 ? 'selected' : undefined">30 jours</option>
                            </select>
                        </div>
                        <div class="filter-group">
                            <label>Période stats</label>
                            <select class="filter-input"
                                    t-on-change="(ev) => this.onFilterChange('recent_days', ev)">
                                <option value="7" t-att-selected="state.filters.recent_days === 7 ? 'selected' : undefined">7 jours</option>
                                <option value="30" t-att-selected="state.filters.recent_days === 30 ? 'selected' : undefined">30 jours</option>
                                <option value="60" t-att-selected="state.filters.recent_days === 60 ? 'selected' : undefined">60 jours</option>
                                <option value="90" t-att-selected="state.filters.recent_days === 90 ? 'selected' : undefined">90 jours</option>
                            </select>
                        </div>
                    </div>
                    <div class="filters-actions">
                        <button class="btn-apply" t-on-click="applyFilters">
                            <i class="fa fa-check"/> Appliquer
                        </button>
                        <button class="btn-reset" t-on-click="resetFilters">
                            <i class="fa fa-times"/> Réinitialiser
                        </button>
                    </div>
                </div>
            </div>

            <t t-if="state.loading">
                <div class="loading">
                    <i class="fa fa-spinner fa-spin fa-2x me-2"/> Chargement...
                </div>
            </t>

            <t t-elif="state.loadError">
                <div class="db-load-error">
                    <i class="fa fa-exclamation-triangle fa-2x mb-2 d-block"/>
                    <t t-esc="state.loadError"/>
                </div>
            </t>

            <t t-else="">
                <!-- KPI Cards -->
                <div class="kpi-row">
                    <div class="kpi-card sessions clickable" t-on-click="() => this.openSessions()">
                        <div class="kpi-value" t-esc="state.data.open_sessions_count || 0"/>
                        <div class="kpi-label">Sessions ouvertes</div>
                    </div>
                    <div class="kpi-card orders_today clickable" t-on-click="() => this.openOrdersToday()">
                        <div class="kpi-value" t-esc="state.data.orders_today_count || 0"/>
                        <div class="kpi-label">Cmd aujourd'hui</div>
                    </div>
                    <div class="kpi-card ca_today">
                        <div class="kpi-value"><t t-esc="formatCurrency(state.data.ca_today)"/></div>
                        <div class="kpi-label">CA aujourd'hui</div>
                    </div>
                    <div class="kpi-card avg_basket">
                        <div class="kpi-value"><t t-esc="formatCurrency(state.data.avg_basket)"/></div>
                        <div class="kpi-label">Panier moyen</div>
                    </div>
                    <div class="kpi-card ca_month clickable" t-on-click="() => this.openMonthOrders()">
                        <div class="kpi-value"><t t-esc="formatCurrency(state.data.ca_month)"/></div>
                        <div class="kpi-label">CA ce mois</div>
                    </div>
                    <div class="kpi-card qty_month">
                        <div class="kpi-value">
                            <t t-esc="formatQtyMonth(state.data.qty_month)"/> kg
                        </div>
                        <div class="kpi-label"><i class="fa fa-balance-scale me-1"/>Quantité du mois</div>
                    </div>
                    <div class="kpi-card orders_month clickable" t-on-click="() => this.openMonthOrders()">
                        <div class="kpi-value" t-esc="state.data.orders_month_count || 0"/>
                        <div class="kpi-label">Cmd ce mois</div>
                    </div>
                    <div class="kpi-card returns clickable" t-on-click="() => this.openReturnsToday()">
                        <div class="kpi-value" t-esc="state.data.returns_today_count || 0"/>
                        <div class="kpi-label">Retours</div>
                    </div>
                    <div class="kpi-card clients">
                        <div class="kpi-value" t-esc="state.data.distinct_partners || 0"/>
                        <div class="kpi-label">Clients servis</div>
                    </div>
                </div>

                <!-- Grille par LIGNES et non par colonnes : les trois graphiques de cet
                     onglet n'ont pas les memes besoins de largeur. Le comparatif porte deux
                     series sur 31 jours (62 barres) : en demi-colonne il tombe a ~28px par
                     jour, en pleine largeur il en a 60 a 1920. Les tableaux et les deux
                     autres graphiques restent en 2 colonnes. -->
                <div class="db-columns db-rows">
                    <!-- Comparatif mois en cours / mois precedent -->
                    <!-- Modified by: odoo-frontend agent — 2026-07-31 -->
                    <!-- Ce bloc ne suit PAS le filtre de date : il est defini par
                         le calendrier. Le libelle de section le dit, sinon un
                         utilisateur qui filtre mars lirait ces chiffres comme
                         etant ceux de mars. -->
                    <div class="db-section span-2">
                        <div class="db-section-title">
                            <i class="fa fa-exchange me-2"/>
                            Comparatif mois en cours / mois précédent
                            <span class="float-end section-meta">
                                <t t-esc="comparePeriodLabel()"/>
                            </span>
                        </div>
                        <t t-if="state.data.compare_months and state.data.compare_months.days.length">
                            <t t-set="cmp" t-value="state.data.compare_months"/>
                            <div class="cmp-summary">
                                <div class="cmp-figures">
                                    <span class="cmp-fig cmp-fig-cur">
                                        <b t-esc="formatCurrency(cmp.total_current)"/>
                                        <i><t t-esc="cmp.current_label"/> à date (<t t-esc="cmp.elapsed_days"/> j)</i>
                                    </span>
                                    <span class="cmp-fig cmp-fig-prev">
                                        <b t-esc="formatCurrency(cmp.total_previous_same)"/>
                                        <i><t t-esc="cmp.previous_label"/> — mêmes <t t-esc="cmp.elapsed_days"/> jours</i>
                                    </span>
                                    <t t-if="!isNum(cmp.delta_pct)">
                                        <span class="cmp-delta cmp-delta-na">—</span>
                                    </t>
                                    <t t-else="">
                                        <span t-attf-class="cmp-delta {{ cmp.delta_pct >= 0 ? 'cmp-delta-up' : 'cmp-delta-down' }}">
                                            <t t-esc="cmp.delta_pct >= 0 ? '▲ +' : '▼ '"/><t t-esc="formatPct(cmp.delta_pct)"/> %
                                        </span>
                                    </t>
                                    <span class="cmp-fig cmp-fig-ref">
                                        <b t-esc="formatCurrency(cmp.total_previous_full)"/>
                                        <i><t t-esc="cmp.previous_label"/> complet</i>
                                    </span>
                                </div>
                                <div class="cmp-meta">
                                    <!-- Legende dans l'ordre des barres (M-1 puis M,
                                         chronologique), pas dans celui des chiffres de
                                         synthese qui mettent le mois en cours en tete. -->
                                    <span class="cmp-legend">
                                        <span class="cmp-key cmp-key-prev"/><t t-esc="cmp.previous_label"/>
                                        <span class="cmp-key cmp-key-cur"/><t t-esc="cmp.current_label"/>
                                    </span>
                                    <span class="cmp-note" t-esc="cmp.note || ''"/>
                                </div>
                            </div>
                            <div class="chart-container chart-container-cmp">
                                <t t-set="cmpMax" t-value="compareScaleMax()"/>
                                <div class="bar-chart cmp-chart">
                                    <t t-foreach="cmp.days" t-as="day" t-key="day.day">
                                        <div class="bar-group" t-att-title="cmpDayTitle(day, cmp)">
                                            <div class="cmp-bars">
                                                <!-- Aucune barre quand la valeur est nulle : une barre
                                                     a zero se lirait "rien vendu ce jour-la", faux pour
                                                     un jour non advenu ou inexistant. -->
                                                <div class="cmp-slot">
                                                    <div t-if="isNum(day.previous)"
                                                         class="bar cmp-prev"
                                                         t-attf-style="height: {{ cmpBarHeight(day.previous, cmpMax) }}px"/>
                                                </div>
                                                <div class="cmp-slot">
                                                    <div t-if="isNum(day.current)"
                                                         class="bar cmp-cur"
                                                         t-attf-style="height: {{ cmpBarHeight(day.current, cmpMax) }}px"/>
                                                </div>
                                            </div>
                                            <div t-att-class="cmpDayLabelClass(day.day, cmp.days.length)">
                                                <t t-if="cmpShowDay(day.day, cmp.days.length)"><t t-esc="day.day"/></t>
                                            </div>
                                        </div>
                                    </t>
                                </div>
                                <div class="cmp-scale">max <t t-esc="formatCompact(cmpMax)"/></div>
                            </div>
                        </t>
                        <t t-else="">
                            <div class="db-empty-state">Comparatif indisponible</div>
                        </t>
                    </div>
                    <div class="db-section">
                        <div class="db-section-title">
                            <i class="fa fa-bar-chart me-2"/>
                            Evolution du CA
                            <span class="float-end section-meta">
                                <t t-esc="state.data.chart_period || ''"/>
                            </span>
                        </div>
                        <div class="chart-container">
                            <div class="bar-chart">
                                <t t-foreach="state.data.daily_ca" t-as="day" t-key="day.date">
                                    <div class="bar-group">
                                        <div class="bar-value" t-esc="formatCurrency(day.total)"/>
                                        <div class="bar"
                                             t-attf-style="height: {{ getBarHeight(day.total) }}px"/>
                                        <div class="bar-label" t-esc="day.date"/>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </div>

                    <!-- CA realise vs budget du mois -->
                    <!-- Modified by: odoo-frontend agent — 2026-07-31 -->
                    <div class="db-section">
                        <div class="db-section-title">
                            <i class="fa fa-bullseye me-2"/>CA réalisé vs budget
                            <span class="float-end section-meta">
                                <t t-esc="budgetPeriodLabel()"/>
                            </span>
                        </div>
                        <!-- Modified by: odoo-frontend agent — 2026-08-03 -->
                        <!-- Quatre statuts au contrat (missing / error / forbidden /
                             ok) plus, en statut ok, un message du serveur : cinq
                             situations distinctes. Le TEXTE vient du serveur (les
                             deux ecrans doivent dire exactement la meme chose),
                             l'icone porte la difference de nature. 'forbidden' est
                             le cas normal de la plupart des utilisateurs depuis que
                             la lecture est reservee a un groupe dedie : il ne doit
                             ressembler ni a une panne ni a un ecran vide.
                             Message, synthèse et tableau sont INDÉPENDANTS : le
                             serveur envoie un message AVEC des lignes dès que les
                             objectifs sont indisponibles, et un message SEUL quand il
                             n'y a rien à lister (filtre caissier). -->
                        <t t-if="!state.data.budget_vs_actual">
                            <div class="db-empty-state">
                                <i class="fa fa-info-circle me-1"/>Budget indisponible
                            </div>
                        </t>
                        <t t-else="">
                            <t t-set="bud" t-value="state.data.budget_vs_actual"/>
                            <t t-if="budgetHasState(bud)">
                                <div class="db-empty-state">
                                    <i t-attf-class="fa {{ budgetStateIcon(bud) }} {{ budgetStateClass(bud) }} me-1"/>
                                    <t t-esc="budgetStateText(bud)"/>
                                </div>
                            </t>
                            <t t-if="budgetShowFallback(bud)">
                                <div class="db-empty-state">
                                    <i class="fa fa-info-circle me-1"/>Aucun budget à afficher.
                                </div>
                            </t>
                            <!-- Même partage qu'au niveau de la ligne : l'avancement
                                 est neutre (une progression, pas un verdict), le rythme
                                 porte le vert/rouge. Le budget plein reste affiché,
                                 c'est l'objectif et il ne bouge pas ; le budget à date
                                 est la base de la couleur, il est donc donné aussi.
                                 Masquée dès que les objectifs ne sont pas lisibles :
                                 ses totaux vaudraient 0 pour un objectif INCONNU. -->
                            <div class="cmp-summary" t-if="budgetReadable(bud)">
                                <div class="cmp-figures">
                                    <span class="cmp-fig cmp-fig-cur">
                                        <b t-esc="formatCurrency(bud.total_actual)"/>
                                        <i>Réalisé à date (<t t-esc="bud.elapsed_days"/> j / <t t-esc="bud.month_days"/>)</i>
                                    </span>
                                    <span class="cmp-fig cmp-fig-prev">
                                        <b t-esc="formatCurrency(bud.total_budget_month)"/>
                                        <i>Budget <t t-esc="bud.month_label"/> (plein mois)</i>
                                    </span>
                                    <!-- Le " %" est DANS la branche : formatPct rend déjà "—"
                                         quand le taux n'existe pas, et "— % du budget" n'est pas
                                         une phrase. La page /direction écrit "— du budget" ; les
                                         deux écrans doivent dire la même chose mot pour mot. Cas
                                         désormais atteignable : tous les objectifs saisis à 0
                                         (PdV fermés) donne has_any_budget=true, donc synthèse
                                         affichée, avec un pourcentage nul. -->
                                    <span class="cmp-delta cmp-delta-neutral">
                                        <t t-if="isNum(bud.total_pct_month)">
                                            <t t-esc="formatPct(bud.total_pct_month)"/> % du budget
                                        </t>
                                        <t t-else="">— du budget</t>
                                    </span>
                                    <t t-if="!isNum(bud.total_pct_todate)">
                                        <span class="cmp-delta cmp-delta-na">rythme —</span>
                                    </t>
                                    <t t-else="">
                                        <span t-attf-class="cmp-delta {{ bud.total_pct_todate >= 100 ? 'cmp-delta-up' : 'cmp-delta-down' }}">
                                            <t t-esc="bud.total_pct_todate >= 100 ? '▲ ' : '▼ '"/><t t-esc="formatPct(bud.total_pct_todate)"/> % du rythme attendu
                                        </span>
                                    </t>
                                    <span class="cmp-fig cmp-fig-ref">
                                        <b t-esc="formatCurrency(bud.total_budget_todate)"/>
                                        <i>Budget à date</i>
                                    </span>
                                </div>
                                <div class="cmp-meta">
                                    <span class="cmp-legend"><t t-esc="bud.total_count"/> point(s) de vente</span>
                                    <span class="cmp-note" t-esc="bud.note || ''"/>
                                </div>
                            </div>
                            <!-- Une ligne par PdV, tous les PdV : une jauge horizontale
                                 ne dépend pas du nombre de lignes, contrairement aux
                                 paires de barres verticales. Même conteneur scrollable à
                                 en-tête fixe que les autres tableaux de l'écran.
                                 Listé même quand aucun objectif n'est lisible : le
                                 réalisé du MOIS par PdV est une donnée réelle, absente
                                 du reste de l'écran (le tableau "CA par PdV" suit le
                                 filtre de date, pas le mois calendaire). Les colonnes
                                 d'objectif disent alors pourquoi elles sont vides. -->
                            <div class="table-wrapper" t-if="budgetShowTable(bud)">
                                <table class="mo-table">
                                    <thead>
                                        <tr>
                                            <th>Point de vente</th>
                                            <th>Atteinte</th>
                                            <th class="text-end">Réalisé</th>
                                            <th class="text-end">Budget mois</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="bud.rows" t-as="row" t-key="row.id">
                                            <tr>
                                                <td t-esc="row.name"/>
                                                <!-- Trois rendus distincts : pas d'objectif ("—"),
                                                     objectif sans taux calculable ("s. o.", cas type
                                                     de l'objectif à 0), objectif mesurable (jauge).
                                                     C'est has_budget qui tranche, pas la véracité du
                                                     montant — un objectif saisi à 0 EST un objectif. -->
                                                <td class="bud-cell">
                                                    <t t-if="budgetShowGauge(row)">
                                                        <span class="bud-gauge" role="img"
                                                              t-att-title="budgetGaugeLabel(row)"
                                                              t-att-aria-label="budgetGaugeLabel(row)">
                                                            <span t-attf-class="bud-gauge-fill {{ budgetPaceClass(row) }}"
                                                                  t-attf-style="width: {{ budgetGaugeWidth(row) }}%"/>
                                                        </span>
                                                        <span t-attf-class="bud-pct {{ budgetPaceClass(row) }}">
                                                            <t t-esc="formatPct(row.pct_month)"/> %
                                                        </span>
                                                    </t>
                                                    <t t-elif="budgetShowFlat(row)">
                                                        <!-- Sans rail : un rail vide se lirait
                                                             "0 % réalisé", ce qui serait faux.
                                                             role/aria-label comme la jauge : "s. o."
                                                             ne veut rien dire lu à voix haute. -->
                                                        <span class="bud-pct cell-muted" role="img"
                                                              t-att-title="budgetZeroTitle(row)"
                                                              t-att-aria-label="budgetZeroTitle(row)">s. o.</span>
                                                    </t>
                                                    <t t-else="">
                                                        <span class="cell-muted" role="img"
                                                              t-att-title="budgetNoTargetTitle()"
                                                              t-att-aria-label="budgetNoTargetTitle()">—</span>
                                                    </t>
                                                </td>
                                                <td class="text-end"><t t-esc="formatCurrency(row.actual)"/></td>
                                                <!-- Montant réel de l'objectif, zéro compris : seule
                                                     l'absence d'objectif donne "—". -->
                                                <td class="text-end">
                                                    <t t-if="budgetHasTarget(row)"><t t-esc="formatCurrency(row.budget_month)"/></t>
                                                    <t t-else=""><span class="cell-muted" role="img"
                                                                       t-att-title="budgetNoTargetTitle()"
                                                                       t-att-aria-label="budgetNoTargetTitle()">—</span></t>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </t>
                    </div>

                    <!-- Top produits -->
                    <div class="db-section">
                        <div class="db-section-title">
                            <!-- Titre construit en JS : voir topProductsTitle() -->
                            <i class="fa fa-trophy me-2"/><t t-esc="topProductsTitle()"/>
                            <span class="float-end section-meta">
                                <t t-esc="state.data.top_products_period || ''"/> ·
                                <strong t-esc="state.data.total_orders_recent"/> cmd
                                / <strong t-esc="formatCurrency(state.data.total_ca_recent)"/>
                            </span>
                        </div>
                        <t t-if="state.data.top_products.length">
                          <div class="table-wrapper">
                            <table class="mo-table top-products-table">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Produit</th>
                                        <th class="text-end">Qte vendue</th>
                                        <th class="text-end">CA</th>
                                        <th>PdV principal</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.data.top_products" t-as="prod" t-key="prod_index">
                                        <tr>
                                            <td>
                                                <span t-attf-class="rank-badge {{ prod_index &lt; 3 ? 'rank-top' : '' }}">
                                                    <t t-esc="prod_index + 1"/>
                                                </span>
                                            </td>
                                            <td t-esc="prod.product"/>
                                            <td class="text-end" t-esc="formatQty(prod.qty)"/>
                                            <td class="text-end"><t t-esc="formatCurrency(prod.ca)"/></td>
                                            <td class="top-pos-cell">
                                                <t t-if="prod.top_pos">
                                                    <span class="top-pos-name" t-esc="prod.top_pos"/>
                                                    <span t-if="prod.top_pos_share"
                                                          t-attf-class="share-badge {{ prod.top_pos_share &gt; 100 ? 'share-anomaly' : '' }}"
                                                          t-att-title="shareTitle(prod.top_pos_share)"
                                                          t-esc="formatShare(prod.top_pos_share)"/>
                                                </t>
                                                <t t-else="">
                                                    <span class="cell-muted">—</span>
                                                </t>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                          </div>
                        </t>
                        <t t-else="">
                            <!-- Meme libelle que /direction, dont le helper table()
                                 rend "Aucune donnée" pour un tableau vide. Le titre de
                                 section porte deja le contexte (quel bloc, quelle
                                 periode), le libelle n'a pas a le repeter. -->
                            <div class="db-empty-state">Aucune donnée</div>
                        </t>
                    </div>

                    <!-- CA par PdV -->
                    <div class="db-section">
                        <div class="db-section-title">
                            <i class="fa fa-shopping-bag me-2"/>CA par Point de Vente
                            <span class="float-end section-meta">
                                <t t-esc="state.data.ca_by_pos_period || ''"/> ·
                                <t t-esc="(state.data.ca_by_pos || []).length"/> ligne(s)
                            </span>
                        </div>
                        <t t-if="state.data.ca_by_pos and state.data.ca_by_pos.length">
                          <div class="table-wrapper">
                            <table class="mo-table">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Point de Vente</th>
                                        <th class="text-end">Commandes</th>
                                        <th class="text-end">Qte vendue</th>
                                        <th class="text-end">Panier moyen</th>
                                        <th class="text-end">CA</th>
                                        <th class="text-end">% du total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.data.ca_by_pos" t-as="pos" t-key="pos_index">
                                        <tr>
                                            <td t-esc="pos.date"/>
                                            <td t-esc="pos.name"/>
                                            <td class="text-end" t-esc="pos.count"/>
                                            <td class="text-end" t-esc="formatQty(pos.total_qty)"/>
                                            <td class="text-end"><t t-esc="formatCurrency(pos.avg_basket)"/></td>
                                            <td class="text-end"><t t-esc="formatCurrency(pos.amount)"/></td>
                                            <td class="text-end">
                                                <div class="pct-bar-container">
                                                    <div class="pct-bar-fill" t-attf-style="width: {{ pos.pct }}%"/>
                                                </div>
                                                <span class="pct-label"><t t-esc="pos.pct"/>%</span>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                          </div>
                        </t>
                        <t t-else="">
                            <!-- Idem : "Aucune donnée", comme /direction. L'ancien
                                 libelle portait de surcroit une faute d'accent. -->
                            <div class="db-empty-state">Aucune donnée</div>
                        </t>
                    </div>

                    <!-- Sessions actives -->
                    <div class="db-section span-2">
                        <div class="db-section-title">
                            <i class="fa fa-desktop me-2"/>Sessions actives
                            <span class="float-end section-meta">
                                <t t-esc="state.data.active_sessions.length"/> session(s)
                            </span>
                        </div>
                        <t t-if="state.data.active_sessions.length">
                          <div class="table-wrapper">
                            <table class="mo-table">
                                <thead>
                                    <tr>
                                        <th>Session</th>
                                        <th>Caissier</th>
                                        <th>Point de vente</th>
                                        <th>Ouverture</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.data.active_sessions" t-as="sess" t-key="sess.id">
                                        <tr>
                                            <td t-esc="sess.name"/>
                                            <td t-esc="sess.user_id ? sess.user_id[1] : '-'"/>
                                            <td t-esc="sess.config_id ? sess.config_id[1] : '-'"/>
                                            <td t-esc="formatDatetime(sess.start_at)"/>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                          </div>
                        </t>
                        <t t-else="">
                            <div class="db-empty-state">
                                <i class="fa fa-power-off fa-2x mb-2 d-block"/>
                                Aucune session ouverte
                            </div>
                        </t>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>
